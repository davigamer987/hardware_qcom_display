cc_library_shared {
    name: "copybit.msm8994",
    defaults: ["display_defaults"],
    relative_install_path: "hw",
    cflags: [
        "-DLOG_TAG=\"qdcopybit\"",
        "-DCOPYBIT_Z180=1",
        "-DC2D_SUPPORT_DISPLAY=1",
    ],
    srcs: [
        "copybit_c2d.cpp",
        "software_converter.cpp",
    ],
    shared_libs: [
        "libdl",
        "libmemalloc",
        "libEGL",
        "libGLESv1_CM",
    ],
    header_libs: [
        "generated_kernel_headers",
        "libEGL_headers",
        "libGLESv1_CM_headers",
    ],
}
